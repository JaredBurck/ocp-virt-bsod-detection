      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 41
      },
      "id": 9,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "bsod:vmi_disk_latency:worst_1h{name=~\"$vm\"} / bsod:vmi_disk_latency:worst_24h{name=~\"$vm\"} > 0",
          "legendFormat": "{{ namespace }}/{{ name }}",
          "refId": "A"
        }
      ],
      "title": "Storage Latency Trend (1h / 24h ratio, worst direction)",
