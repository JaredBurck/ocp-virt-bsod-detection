{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "BSOD risk posture for OpenShift Virtualization Windows VMs. Surfaces BSODRisk_* PrometheusRule alerts separated by scope (VM-level, node-level), fleet readiness, storage latency trends, and guest-side metrics (windows_exporter).",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": false,
      "tags": [],
      "targetBlank": true,
      "title": "KCS 7132512 - Storage Latency",
      "type": "link",
      "url": "https://access.redhat.com/solutions/7132512"
    },
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": false,
      "tags": [],
      "targetBlank": true,
      "title": "KCS 7141291 - Guest Crash",
      "type": "link",
      "url": "https://access.redhat.com/solutions/7141291"
    },
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": false,
      "tags": [],
      "targetBlank": true,
      "title": "KCS 7132511 - CPU/Migration",
      "type": "link",
      "url": "https://access.redhat.com/solutions/7132511"
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 100,
      "title": "Alert Overview",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Total count of all BSODRisk alerts currently firing across the cluster (includes VM-level, node-level, and cluster-scoped alerts).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "green",
                  "text": "Inactive"
                }
              },
              "type": "value"
            },
            {
              "options": {
                "1": {
                  "color": "red",
                  "text": "Firing"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "count(ALERTS{alertname=~\"BSODRisk_.*\", alertstate=\"firing\"}) or vector(0)",
          "legendFormat": "{{ alertname }}",
          "refId": "A"
        }
      ],
      "title": "Total Firing Alerts",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Count of distinct BSODRisk alerts currently firing, by severity. Colors match standard severity semantics: blue=info, yellow=warning, red=critical.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "0"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "info"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "warning"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "critical"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "count(ALERTS{alertname=~\"BSODRisk_.*\", alertstate=\"firing\"}) by (severity) or vector(0)",
          "legendFormat": "{{ severity }}",
          "refId": "A"
        }
      ],
      "title": "Firing Alerts by Severity",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "id": 101,
      "title": "Per-VM Risk",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Number of active BSOD risk alerts per VM. Each cell shows one VM with at least one firing alert. Color intensity: yellow=1, orange=2, red=3+. Only VM-scoped alerts appear here; node-level alerts are shown separately below.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "count by (name, namespace) (ALERTS{alertname=~\"BSODRisk_.*\", alertstate=\"firing\", name!=\"\"} or label_replace(ALERTS{alertname=~\"BSODRisk_.*\", alertstate=\"firing\", vm_name!=\"\"}, \"name\", \"$1\", \"vm_name\", \"(.*)\"))",
          "legendFormat": "{{ namespace }}/{{ name }}",
          "refId": "A"
        }
      ],
      "title": "Per-VM Active BSOD Alerts",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "id": 106,
      "title": "Node & Cluster Alerts",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Node-scoped BSODRisk alerts such as AMD microcode verification. These are NOT VM-specific -- they indicate risk conditions on the underlying compute node that can affect any VM scheduled there. Cluster-scoped alerts (e.g. recent migration detected) also appear here.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "orange",
                "value": 2
              }
            ]
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "id": 11,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "count by (node) (ALERTS{alertname=~\"BSODRisk_.*\", alertstate=\"firing\", name=\"\"})",
          "legendFormat": "{{ node }}",
          "refId": "A"
        }
      ],
      "title": "Nodes with Active Risk Alerts",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "All currently firing BSODRisk alerts with their scope (VM name or node), severity, and alert type. Use this table to identify exactly which alerts are active and where they originate. Namespace is blank for node/cluster-scoped alerts (e.g. BSODRisk_AMDNodeRequiresMicrocodeVerification) -- those do not relate to any VM's namespace; use the Node column for those rows instead.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "displayMode": "auto"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "custom.displayMode",
                "value": "color-background-solid"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "preview": {
                        "text": "PREVIEW",
                        "color": "orange"
                      }
                    }
                  },
                  {
                    "type": "special",
                    "options": {
                      "match": "empty",
                      "result": {
                        "text": "",
                        "color": "transparent"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "id": 12,
      "options": {
        "footer": {
          "enablePagination": false,
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Severity"
          }
        ]
      },
      "targets": [
        {
          "expr": "ALERTS{alertname=~\"BSODRisk_.*\", alertstate=\"firing\"}",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(alertname|severity|namespace|name|node|bsod_status|Time|Value)$"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true
            },
            "indexByName": {
              "alertname": 0,
              "severity": 1,
              "namespace": 2,
              "name": 3,
              "node": 4,
              "bsod_status": 5
            },
            "renameByName": {
              "alertname": "Alert",
              "severity": "Severity",
              "namespace": "Namespace",
              "name": "VM",
              "node": "Node",
              "bsod_status": "Status"
            }
          }
        }
      ],
      "title": "All Firing Alerts (Detail)",
      "type": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Shows the CPU vendor distribution across worker nodes. A cluster with both AMD and Intel nodes is heterogeneous -- live migrations on such clusters carry elevated BSOD risk (CLOCK_WATCHDOG_TIMEOUT, MACHINE_CHECK_EXCEPTION). Uses kube_node_labels with KubeVirt cpu-vendor labels, joined against kube_node_role{role=\"worker\"} to scope to worker nodes. Requires kube-state-metrics node label allowlist (default on OCP 4.14+). Confirmed live this panel always showed 0 for both series before this fix: filtering kube_node_labels itself on label_node_role_kubernetes_io_worker=\"true\" can never match on OpenShift, because node-role.kubernetes.io/* labels are presence-only and carry an empty string value (verified via `oc get node -o jsonpath`), and Prometheus's data model treats a label with an empty value as equivalent to that label being absent -- no allowlist setting fixes this, since the label is exposed correctly, just never with the value \"true\". kube_node_role is kube-state-metrics' purpose-built metric for node roles (it parses the presence-only label into a proper role= value) and is the only reliable way to scope by role.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              }
            ]
          },
          "noValue": "No data (CPU-vendor labels not exposed)"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "id": 13,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "count(kube_node_labels{label_cpu_vendor_node_kubevirt_io_intel=\"true\"} and on(node) kube_node_role{role=\"worker\"}) or vector(0)",
          "legendFormat": "Intel Nodes",
          "refId": "A"
        },
        {
          "expr": "count(kube_node_labels{label_cpu_vendor_node_kubevirt_io_amd=\"true\"} and on(node) kube_node_role{role=\"worker\"}) or vector(0)",
          "legendFormat": "AMD Nodes",
          "refId": "B"
        }
      ],
      "title": "Node CPU Vendor Distribution (R-9)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Cluster CPU heterogeneity gauge from the bsod:cluster_cpu_model_count:gauge recording rule. Values: 0 = no vendor labels (allowlist not configured), 1 = homogeneous (all same vendor), 2 = heterogeneous (AMD + Intel nodes). A value of 2 means BSODRisk_HeterogeneousCPUMigration will fire on any VM live migration.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "text",
                  "text": "No Data"
                },
                "1": {
                  "color": "green",
                  "text": "Homogeneous"
                },
                "2": {
                  "color": "orange",
                  "text": "Heterogeneous"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              },
              {
                "color": "orange",
                "value": 2
              }
            ]
          },
          "noValue": "Recording rule not evaluated"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 25
      },
      "id": 14,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "bsod:cluster_cpu_model_count:gauge",
          "legendFormat": "CPU Vendor Groups",
          "refId": "A"
        }
      ],
      "title": "Cluster CPU Heterogeneity Status",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "id": 102,
      "title": "Fleet Readiness",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Count of VMs with at least one active BSODRisk alert, grouped by namespace. Only VM-scoped alerts are counted (node and cluster alerts excluded).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "count by (namespace) (count by (name, namespace) (ALERTS{alertname=~\"BSODRisk_.*\", alertstate=\"firing\", name!=\"\"} or label_replace(ALERTS{alertname=~\"BSODRisk_.*\", alertstate=\"firing\", vm_name!=\"\"}, \"name\", \"$1\", \"vm_name\", \"(.*)\"))) or vector(0)",
          "legendFormat": "{{ namespace }}",
          "refId": "A"
        }
      ],
      "title": "VMs with Active Alerts by Namespace",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Total running VMs tracked by KubeVirt versus those with at least one active VM-level BSOD risk alert. Note: 'Total Running VMs' includes ALL running VMIs (the KubeVirt os label is not reliably set, so Windows-only filtering is not applied here).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "count(kubevirt_vmi_info)",
          "legendFormat": "Total Running VMs",
          "refId": "A"
        },
        {
          "expr": "count(count by (name, namespace) (ALERTS{alertname=~\"BSODRisk_.*\", alertstate=\"firing\", name!=\"\"} or label_replace(ALERTS{alertname=~\"BSODRisk_.*\", alertstate=\"firing\", vm_name!=\"\"}, \"name\", \"$1\", \"vm_name\", \"(.*)\"))) or vector(0)",
          "legendFormat": "VMs at Risk",
          "refId": "B"
        }
      ],
      "title": "Fleet Summary",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "id": 103,
      "title": "Storage Latency",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Average disk read latency per VM over time. Amber marks the 0.5s sustained WARN threshold and red the 1.0s CRITICAL threshold used by BSODRisk_StorageLatencyElevated / BSODRisk_StorageLatencyHigh. These are deliberately far below the 60s VirtIO IoTimeoutValue: what causes MEMORY_MANAGEMENT (0x1A) is a TAIL spike during a storage brownout, so an hourly mean anywhere near 60s means the guest has already bugchecked. Sourced from shared/storage-latency-thresholds.json (KCS-7132512).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisLabel": "Latency (seconds)",
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1.0
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 33
      },
      "id": 6,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (name, namespace, drive) (rate(kubevirt_vmi_storage_read_times_seconds_total{name=~\"$vm\"}[5m])) / sum by (name, namespace, drive) (rate(kubevirt_vmi_storage_iops_read_total{name=~\"$vm\"}[5m])) > 0",
          "legendFormat": "{{ namespace }}/{{ name }}/{{ drive }}",
          "refId": "A"
        }
      ],
      "title": "VM Disk Read Latency (avg per I/O)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Mirrors BSODRisk_StorageLatencyTrending. Worst-direction series (max of read and write) so the panel matches the alert exactly.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisLabel": "Ratio (1h/24h)",
