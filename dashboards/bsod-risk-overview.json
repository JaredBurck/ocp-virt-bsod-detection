    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 49
      },
      "id": 104,
      "title": "Memory Pressure",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Shows QEMU process RSS vs allocated domain memory. Without QGA/balloon driver, this will show ~100% (all memory pinned). With QGA, this accurately reflects guest utilization.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisLabel": "Utilization",
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.85
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 50
      },
      "id": 7,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "kubevirt_vmi_memory_used_bytes{name=~\"$vm\"} / on(name, namespace) kubevirt_vmi_memory_domain_bytes{name=~\"$vm\"}",
          "legendFormat": "{{namespace}}/{{name}}",
          "refId": "A"
        }
      ],
      "title": "Windows VM Memory Utilization (Guest / Domain)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Windows pagefile utilization per VM (requires windows_exporter with pagefile collector). Values above 90% (yellow threshold) amplify BSOD risk when combined with slow storage.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisLabel": "Utilization",
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.9
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 58
      },
      "id": 10,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "(windows_pagefile_limit_bytes - windows_pagefile_free_bytes) / windows_pagefile_limit_bytes",
          "legendFormat": "{{vm_name}} ({{file}})",
          "refId": "A"
        }
      ],
      "title": "Pagefile Pressure (windows_exporter)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 66
      },
      "id": 105,
      "title": "Driver Version Distribution (windows_exporter)",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Distribution of virtio-win driver versions across the Windows VM fleet. Requires windows_exporter with bsod-textfile-collector.ps1 deployed in guest VMs. See windows-exporter/README.md for setup.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "align": "auto",
            "displayMode": "auto"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 67
      },
      "id": 8,
      "options": {
        "footer": {
          "enablePagination": false,
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Count"
          }
        ]
      },
      "targets": [
        {
          "expr": "bsod_virtio_driver_version == 1",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "container": true,
              "endpoint": true,
              "instance": true,
              "job": true,
              "pod": true,
              "prometheus": true,
              "service": true
            },
            "indexByName": {
              "vm_name": 0,
              "vm_namespace": 1,
              "version": 2
            },
            "renameByName": {
              "vm_name": "VM",
              "vm_namespace": "Namespace",
              "version": "VirtIO Driver Version"
            }
          }
        }
      ],
      "title": "VirtIO Driver Versions by VM (windows_exporter)",
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 73
      },
      "id": 108,
      "title": "Guest CPU & Memory Saturation (windows_exporter)",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Guest-observed CPU utilization (100% minus the idle-mode share of windows_cpu_time_total). Requires windows_exporter with the cpu collector (enabled by default and by install-windows-exporter.ps1). R-46: this collector was always enabled but never consumed by any downstream panel/alert before this.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisLabel": "Utilization",
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 90
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 74
      },
      "id": 17,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "100 - (100 * avg by (vm_name, vm_namespace) (rate(windows_cpu_time_total{mode=\"idle\"}[5m])))",
          "legendFormat": "{{vm_namespace}}/{{vm_name}}",
          "refId": "A"
        }
      ],
      "title": "Guest CPU Utilization (windows_exporter)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Guest-observed physical memory utilization (100% minus free/total, from windows_exporter's memory collector). Distinct from the 'Windows VM Memory Utilization (Guest / Domain)' panel above, which is the hypervisor's ballooned-domain view. Requires windows_exporter with the memory collector (enabled by default and by install-windows-exporter.ps1). R-46: this collector was always enabled but never consumed by any downstream panel/alert before this.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisLabel": "Utilization",
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 90
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 74
      },
      "id": 18,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "100 - (100 * windows_memory_physical_free_bytes / windows_memory_physical_total_bytes)",
          "legendFormat": "{{vm_namespace}}/{{vm_name}}",
          "refId": "A"
        }
      ],
      "title": "Guest Physical Memory Utilization (windows_exporter)",
      "type": "timeseries"
    },
    {
      "type": "row",
      "title": "Crash Detection & Risk Context",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 82
      },
      "id": 107,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Per-VM Risk Factor Count",
      "description": "Pre-computed BSOD risk factor count per VM (0-3). Tracks driver outdated, low IoTimeout, and crash dump disabled conditions. Higher values correlate with increased BSOD probability.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 83
      },
      "id": 15,
      "targets": [
        {
          "expr": "bsod:vm_risk_factor_count:gauge{vm_name=~\"$vm\"}",
          "legendFormat": "{{vm_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "spanNulls": true,
            "axisSoftMin": 0,
            "axisSoftMax": 3
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "last"
          ],
          "displayMode": "table",
          "placement": "right"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Crash Events (Proxy: Exporter Down)",
      "description": "Shows windows_exporter target availability. A drop to 0 while the VMI exists indicates a potential guest crash (BSOD, unexpected reboot). Corresponds to BSODRisk_GuestUnexpectedRestart alert.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 83
      },
      "id": 16,
      "targets": [
        {
          "expr": "label_replace(up{job=~\"bsod-windows-exporter.*\", vm_name=~\"$vm\"}, \"name\", \"$1\", \"vm_name\", \"(.*)\")",
          "legendFormat": "{{vm_name}} (up)",
          "refId": "A"
        },
        {
          "expr": "ALERTS{alertname=\"BSODRisk_GuestUnexpectedRestart\", vm_name=~\"$vm\"}",
          "legendFormat": "{{vm_name}} ALERT",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "last"
          ],
          "displayMode": "table",
          "placement": "right"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
