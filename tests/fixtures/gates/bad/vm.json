{
  "apiVersion": "kubevirt.io/v1",
  "kind": "VirtualMachine",
  "metadata": {
    "name": "win2k22-bad",
    "namespace": "bsod-test",
    "labels": {
      "vm.kubevirt.io/os": "windows2k22",
      "app.kubernetes.io/part-of": "bsod-test"
    },
    "annotations": {
      "vm.kubevirt.io/os": "windows2k22"
    }
  },
  "spec": {
    "runStrategy": "Halted",
    "template": {
      "metadata": {
        "annotations": {
          "vm.kubevirt.io/os": "windows2k22"
        },
        "labels": {
          "kubevirt.io/domain": "win2k22-bad",
          "vm.kubevirt.io/name": "win2k22-bad"
        }
      },
      "spec": {
        "architecture": "amd64",
        "domain": {
          "cpu": {
            "cores": 1,
            "sockets": 4,
            "threads": 1
          },
          "devices": {
            "disks": [
              {
                "name": "rootdisk",
                "bootOrder": 1,
                "disk": {
                  "bus": "sata"
                }
              }
            ],
            "interfaces": [
              {
                "name": "default",
                "masquerade": {},
                "model": "e1000e"
              }
            ]
          },
          "memory": {
            "guest": "4Gi"
          },
          "resources": {
            "requests": {
              "memory": "4Gi"
            }
          }
        },
        "evictionStrategy": "None",
        "networks": [
          {
            "name": "default",
            "pod": {}
          }
        ],
        "terminationGracePeriodSeconds": 3600,
        "volumes": [
          {
            "name": "rootdisk",
            "persistentVolumeClaim": {
              "claimName": "win2k22-bad-rootdisk"
            }
          }
        ]
      }
    }
  }
}