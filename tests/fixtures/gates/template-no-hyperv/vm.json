{
  "apiVersion": "kubevirt.io/v1",
  "kind": "VirtualMachine",
  "metadata": {
    "name": "win2k22-tmpl-test",
    "namespace": "bsod-test",
    "labels": {
      "vm.kubevirt.io/os": "windows2k22"
    },
    "annotations": {}
  },
  "spec": {
    "template": {
      "metadata": {
        "annotations": {
          "vm.kubevirt.io/os": "windows2k22"
        },
        "labels": {}
      },
      "spec": {
        "evictionStrategy": "LiveMigrate",
        "domain": {
          "machine": {"type": "pc-q35-rhel9.4.0"},
          "cpu": {"model": "EPYC-Milan"},
          "features": {
            "hyperv": {
              "relaxed": {},
              "vapic": {},
              "spinlocks": {"spinlocks": 8191},
              "vpindex": {},
              "synic": {},
              "synictimer": {}
            }
          },
          "devices": {
            "disks": [
              {"name": "rootdisk", "disk": {"bus": "virtio"}, "bootOrder": 1}
            ],
            "interfaces": [
              {"name": "default", "masquerade": {}, "model": "virtio"}
            ]
          }
        },
        "volumes": [
          {"name": "rootdisk", "persistentVolumeClaim": {"claimName": "win2k22-tmpl-test-rootdisk"}},
          {"name": "virtiocontainerdisk", "containerDisk": {
            "image": "registry.redhat.io/container-native-virtualization/virtio-win-rhel9@sha256:17b76af03fe7a3f45d63b3e8a9a2ddc3231100619d0e158f73997916580dec68"
          }}
        ]
      }
    }
  }
}
