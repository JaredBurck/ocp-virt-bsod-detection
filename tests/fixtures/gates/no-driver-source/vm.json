{
  "apiVersion": "kubevirt.io/v1",
  "kind": "VirtualMachine",
  "metadata": {
    "name": "win2k22-no-driver-source",
    "namespace": "bsod-test",
    "labels": {
      "vm.kubevirt.io/os": "windows2k22",
      "app.kubernetes.io/part-of": "bsod-test",
      "bsod-test/scenario": "no-virtio-win-source"
    },
    "annotations": {
      "vm.kubevirt.io/os": "windows2k22"
    }
  },
  "spec": {
    "runStrategy": "Halted",
    "template": {
      "metadata": {
        "annotations": {
          "vm.kubevirt.io/os": "windows2k22"
        },
        "labels": {
          "kubevirt.io/domain": "win2k22-no-driver-source",
          "vm.kubevirt.io/os": "windows2k22"
        }
      },
      "spec": {
        "architecture": "amd64",
        "domain": {
          "clock": {
            "timer": {
              "hpet": {
                "present": false
              },
              "hyperv": {},
              "pit": {
                "tickPolicy": "delay"
              },
              "rtc": {
                "tickPolicy": "catchup"
              }
            },
            "utc": {}
          },
          "cpu": {
            "cores": 2,
            "sockets": 1,
            "threads": 1,
            "model": "host-model"
          },
          "devices": {
            "disks": [
              {
                "name": "rootdisk",
                "bootOrder": 1,
                "disk": {
                  "bus": "virtio"
                }
              }
            ],
            "interfaces": [
              {
                "name": "default",
                "masquerade": {},
                "model": "virtio"
              }
            ],
            "inputs": [
              {
                "name": "tablet",
                "type": "tablet",
                "bus": "usb"
              }
            ],
            "tpm": {
              "persistent": true
            }
          },
          "features": {
            "acpi": {},
            "apic": {},
            "hyperv": {
              "frequencies": {},
              "ipi": {},
              "reenlightenment": {},
              "relaxed": {},
              "reset": {},
              "runtime": {},
              "spinlocks": {
                "spinlocks": 8191
              },
              "synic": {},
              "synictimer": {
                "direct": {}
              },
              "tlbflush": {},
              "vapic": {},
              "vpindex": {}
            },
            "smm": {}
          },
          "firmware": {
            "bootloader": {
              "efi": {
                "persistent": true,
                "secureBoot": true
              }
            }
          },
          "machine": {
            "type": "q35"
          },
          "memory": {
            "guest": "4Gi"
          },
          "resources": {
            "requests": {
              "memory": "4Gi"
            }
          }
        },
        "evictionStrategy": "LiveMigrate",
        "networks": [
          {
            "name": "default",
            "pod": {}
          }
        ],
        "terminationGracePeriodSeconds": 3600,
        "volumes": [
          {
            "name": "rootdisk",
            "persistentVolumeClaim": {
              "claimName": "win2k22-no-driver-source-rootdisk"
            }
          }
        ]
      }
    }
  }
}
