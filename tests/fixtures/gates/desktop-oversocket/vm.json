{
  "apiVersion": "kubevirt.io/v1",
  "kind": "VirtualMachine",
  "metadata": {
    "name": "win11-oversocket",
    "namespace": "bsod-test",
    "labels": {
      "vm.kubevirt.io/os": "windows11",
      "vm.kubevirt.io/template": "windows11-desktop-medium",
      "vm.kubevirt.io/template.version": "v0.32.2",
      "app.kubernetes.io/part-of": "bsod-test",
      "bsod-test/scenario": "desktop-socket-limit"
    },
    "annotations": {
      "vm.kubevirt.io/os": "windows11"
    }
  },
  "spec": {
    "runStrategy": "Halted",
    "template": {
      "metadata": {
        "annotations": {
          "vm.kubevirt.io/os": "windows11",
          "vm.kubevirt.io/flavor": "medium",
          "vm.kubevirt.io/workload": "desktop"
        },
        "labels": {
          "kubevirt.io/domain": "win11-oversocket",
          "vm.kubevirt.io/name": "win11-oversocket"
        }
      },
      "spec": {
        "architecture": "amd64",
        "domain": {
          "clock": {
            "timer": {
              "hpet": {
                "present": false
              },
              "hyperv": {},
              "pit": {
                "tickPolicy": "delay"
              },
              "rtc": {
                "tickPolicy": "catchup"
              }
            },
            "utc": {}
          },
          "cpu": {
            "cores": 1,
            "sockets": 4,
            "threads": 1,
            "model": "host-model"
          },
          "devices": {
            "disks": [
              {
                "name": "rootdisk",
                "bootOrder": 1,
                "disk": {
                  "bus": "virtio"
                }
              },
              {
                "name": "virtiocontainerdisk",
                "cdrom": {
                  "bus": "sata"
                }
              }
            ],
            "interfaces": [
              {
                "name": "default",
                "masquerade": {},
                "model": "virtio"
              }
            ],
            "inputs": [
              {
                "name": "tablet",
                "type": "tablet",
                "bus": "usb"
              }
            ],
            "tpm": {
              "persistent": true
            }
          },
          "features": {
            "acpi": {},
            "apic": {},
            "hyperv": {
              "frequencies": {},
              "ipi": {},
              "reenlightenment": {},
              "relaxed": {},
              "reset": {},
              "runtime": {},
              "spinlocks": {
                "spinlocks": 8191
              },
              "synic": {},
              "synictimer": {
                "direct": {}
              },
              "tlbflush": {},
              "vapic": {},
              "vpindex": {}
            },
            "smm": {}
          },
          "firmware": {
            "bootloader": {
              "efi": {
                "persistent": true,
                "secureBoot": true
              }
            }
          },
          "memory": {
            "guest": "4Gi"
          },
          "resources": {
            "requests": {
              "memory": "4Gi"
            }
          }
        },
        "evictionStrategy": "LiveMigrate",
        "networks": [
          {
            "name": "default",
            "pod": {}
          }
        ],
        "terminationGracePeriodSeconds": 3600,
        "volumes": [
          {
            "name": "rootdisk",
            "persistentVolumeClaim": {
              "claimName": "win11-oversocket-rootdisk"
            }
          },
          {
            "name": "virtiocontainerdisk",
            "containerDisk": {
              "image": "registry.redhat.io/container-native-virtualization/virtio-win-rhel9@sha256:17b76af03fe7a3f45d63b3e8a9a2ddc3231100619d0e158f73997916580dec68"
            }
          }
        ]
      }
    }
  }
}
